<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#FFE0E6EB" />
            <corners android:radius="6dp" />
            <stroke
                android:width="1dp"
                android:color="#FFC6D0D9" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/lyrebird_orange" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/lyrebird_surface_alt" />
            <corners android:radius="6dp" />
            <stroke
                android:width="1dp"
                android:color="@color/lyrebird_border" />
        </shape>
    </item>
</selector>