<?xml version="1.0" encoding="utf-8"?>
<!--
  Night variant of the Flight Deck card: same shape and colours as the day one, on the dark
  surface (the mark's orange border and the plumage-blue label are both theme colours).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/lyrebird_surface_alt" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/lyrebird_border" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/lyrebird_orange" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/lyrebird_orange" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/lyrebird_surface" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/lyrebird_orange" />
        </shape>
    </item>
</selector>
