<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lyrebird_background"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/app_name_aircraft"
            android:scaleType="centerInside"
            android:src="@mipmap/ic_main" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_settings_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pixelify_sans"
                android:letterSpacing="0.08"
                android:text="@string/lyrebird_settings_label"
                android:textColor="@color/lyrebird_teal"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_settings_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/dm_sans"
                android:maxLines="1"
                android:textColor="@color/lyrebird_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/button_settings_overflow"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/lyrebird_more_settings"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_more"
            android:tint="@color/lyrebird_text" />

        <ImageButton
            android:id="@+id/button_settings_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/lyrebird_close"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/lyrebird_text" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lyrebird_border" />

    <TextView
        android:id="@+id/text_settings_summary"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/lyrebird_welcome_panel"
        android:ellipsize="end"
        android:fontFamily="@font/space_grotesk"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/lyrebird_text"
        android:textSize="10sp" />

    <LinearLayout
        android:id="@+id/settings_cockpit_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="top"
        android:orientation="horizontal" />
</LinearLayout>
