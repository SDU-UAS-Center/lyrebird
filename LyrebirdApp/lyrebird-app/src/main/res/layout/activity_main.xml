<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lyrebird_background"
    tools:context="com.lyrebird.rc.DJIMainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/view_info_panel"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:background="@color/lyrebird_background"
        android:padding="10dp"
        app:layout_constraintEnd_toStartOf="@+id/msg_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/view_base_info"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/lyrebird_welcome_panel"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toTopOf="@+id/view_case_panel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.66"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@string/app_name_aircraft"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_main" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pixelify_sans"
                        android:letterSpacing="0.14"
                        android:text="@string/lyrebird_brand_label"
                        android:textColor="@color/lyrebird_teal"
                        android:textSize="29sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk"
                        android:letterSpacing="0.08"
                        android:text="@string/lyrebird_ground_station"
                        android:textColor="@color/lyrebird_orange"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_view_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:textColor="@color/lyrebird_text"
                    android:textSize="10sp"
                    tools:text="@string/sdk_version" />

                <TextView
                    android:id="@+id/text_view_package_product_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:text="@string/package_product_category"
                    android:textColor="@color/lyrebird_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/text_view_registered"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:text="@string/unregistered"
                    android:textColor="@color/lyrebird_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/text_view_product_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:text="@string/product_name"
                    android:textColor="@color/lyrebird_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/text_view_is_debug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:text="@string/is_sdk_debug"
                    android:textColor="@color/lyrebird_text"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/view_case_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingBottom="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_base_info"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/lyrebird_background">

            <Button
                    android:id="@+id/widget_list_button"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:foreground="?selectableItemBackground"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/lyrebird_welcome_button"
                    android:enabled="false"
                    android:gravity="center"
                    android:fontFamily="@font/space_grotesk"
                    android:padding="6dp"
                    android:text="@string/widget_list"
                    android:textColor="@color/lyrebird_button_text"
                    android:textSize="14sp" />

            <Button
                    android:id="@+id/testing_tool_button"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:foreground="?selectableItemBackground"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/lyrebird_welcome_button"
                    android:enabled="true"
                    android:gravity="center"
                    android:fontFamily="@font/space_grotesk"
                    android:padding="6dp"
                    android:text="@string/testing_tools"
                    android:textColor="@color/lyrebird_button_text"
                    android:textSize="14sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/msg_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/lyrebird_welcome_panel"
        app:layout_constraintBottom_toBottomOf="@+id/view_info_panel"
        app:layout_constraintLeft_toRightOf="@+id/view_info_panel"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_info_panel" />

    <TextView
        android:id="@+id/text_view_lyrebird_build_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:gravity="start"
        android:lineSpacingExtra="2dp"
        android:fontFamily="@font/dm_sans"
        android:textColor="@color/lyrebird_teal"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@+id/msg_panel"
        app:layout_constraintStart_toStartOf="@+id/msg_panel"
        app:layout_constraintTop_toTopOf="@+id/msg_panel"
        tools:text="Lyrebird app\nDrone: mini1\nBuilt: 2026-05-20 10:33 UTC\nGit: c90e63ce4cb5 dirty\nVersion: 1.0 (1)\nFeatures: WHIP video, sender metrics telemetry" />

    <TextView
        android:id="@+id/text_view_news_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/space_grotesk"
        android:letterSpacing="0.12"
        android:text="@string/news"
        android:textColor="@color/lyrebird_orange"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/msg_panel"
        app:layout_constraintTop_toBottomOf="@+id/text_view_lyrebird_build_info" />

    <com.lyrebird.rc.views.VersionInfoView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/flight_deck_button"
        app:layout_constraintEnd_toEndOf="@+id/msg_panel"
        app:layout_constraintHeight_percent="0.65"
        app:layout_constraintStart_toStartOf="@+id/msg_panel"
        app:layout_constraintTop_toBottomOf="@+id/text_view_news_title"
        app:layout_constraintVertical_bias="0" />

    <Button
        android:id="@+id/flight_deck_button"
        android:layout_width="0dp"
        android:layout_height="92dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/lyrebird_flight_deck_button"
        android:enabled="false"
        android:fontFamily="@font/space_grotesk"
        android:foreground="?selectableItemBackground"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/flight_deck"
        android:textColor="@color/lyrebird_flight_deck_text"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/msg_panel"
        app:layout_constraintEnd_toEndOf="@+id/msg_panel"
        app:layout_constraintStart_toStartOf="@+id/msg_panel" />

    <TextView
        android:id="@+id/text_core_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="test test"
        android:textColor="@color/lyrebird_teal"
        android:textSize="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="SpUsage" />

</androidx.constraintlayout.widget.ConstraintLayout>